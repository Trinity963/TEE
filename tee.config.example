{
  "_comment": "TEE — Trinity's Execution Engine | tee.config.example",
  "_doc": "Copy this file to tee.config and edit to match your system.",

  "version": "1.0.0",

  "models_dirs": [
    {
      "path": "/path/to/your/models",
      "label": "auto",
      "detected_type": "auto",
      "user_renamed": false,
      "watch": true
    }
  ],

  "auto_generate_modelfile": true,

  "backend": "auto",

  "gpu": "auto",

  "gateway": {
    "host": "0.0.0.0",
    "port": 8765,
    "openai_compatible": true,
    "endpoints": [
      "/v1/chat/completions",
      "/v1/models",
      "/v1/embeddings"
    ]
  },

  "sources": {
    "model_index": "https://raw.githubusercontent.com/YOU/TEE/main/model-index/ratings.json",
    "download": [
      "https://huggingface.co",
      "https://modelscope.cn"
    ]
  },

  "health": {
    "smart_check_interval_hours": 6,
    "space_check_interval_seconds": 60,
    "low_space_threshold_percent": 20,
    "critical_space_threshold_percent": 10
  },

  "placement": {
    "prefer_fast_drive_under_gb": 8,
    "prefer_large_storage_over_gb": 20,
    "learn_from_overrides": true,
    "override_threshold": 3
  },

  "runtime": {
    "multi_gpu": "auto",
    "gpu_affinity": "auto",
    "context_default": 4096,
    "unload_idle_after_minutes": 30
  }
}
